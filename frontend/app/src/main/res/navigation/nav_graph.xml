<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/splashFragment">

    <action
        android:id="@+id/action_global_to_contact_list"
        app:destination="@id/contactListFragment"
        app:popUpTo="@id/nav_graph"
        app:popUpToInclusive="true" />

    <action
        android:id="@+id/action_global_to_welcome"
        app:destination="@id/welcomeFragment"
        app:popUpTo="@id/nav_graph"
        app:popUpToInclusive="true" />

    <fragment
        android:id="@+id/splashFragment"
        android:name="com.mohdhussain.hrcontacts.ui.auth.SplashFragment"
        android:label="HR Contacts"
        tools:layout="@layout/fragment_splash" />

    <fragment
        android:id="@+id/welcomeFragment"
        android:name="com.mohdhussain.hrcontacts.ui.auth.WelcomeFragment"
        android:label="HR Contacts"
        tools:layout="@layout/fragment_welcome" />

    <!-- Home tab: the full contact list (scope defaults to ALL). Navigation to the detail screen
         and the add-contact sheet is done by direct destination id from the fragment, since both
         this node and contactsFilteredFragment below host the same Fragment class and a named
         action would only belong to one of them. -->
    <fragment
        android:id="@+id/contactListFragment"
        android:name="com.mohdhussain.hrcontacts.ui.list.ContactListFragment"
        android:label="HR Contacts"
        tools:layout="@layout/fragment_contact_list" />

    <!-- Pushed from contactsHubFragment with a "scope" argument (MINE or BOOKMARKED). A separate
         destination id from contactListFragment so the two never collide in MainActivity's
         tab-selection bookkeeping, even though both resolve to ContactListFragment. Not a
         top-level destination: it hides the bottom nav and relies on its own back arrow. -->
    <fragment
        android:id="@+id/contactsFilteredFragment"
        android:name="com.mohdhussain.hrcontacts.ui.list.ContactListFragment"
        android:label="HR Contacts"
        tools:layout="@layout/fragment_contact_list" />

    <fragment
        android:id="@+id/jobsFragment"
        android:name="com.mohdhussain.hrcontacts.ui.jobs.JobsFragment"
        android:label="@string/jobs_title" />

    <fragment
        android:id="@+id/contactsHubFragment"
        android:name="com.mohdhussain.hrcontacts.ui.hub.ContactsHubFragment"
        android:label="@string/contacts_hub_title" />

    <fragment
        android:id="@+id/profileFragment"
        android:name="com.mohdhussain.hrcontacts.ui.profile.ProfileFragment"
        android:label="@string/nav_you"
        tools:layout="@layout/fragment_profile" />

    <fragment
        android:id="@+id/contactDetailFragment"
        android:name="com.mohdhussain.hrcontacts.ui.detail.ContactDetailFragment"
        android:label="HR Profile"
        tools:layout="@layout/fragment_contact_detail">

        <action
            android:id="@+id/action_detail_to_edit"
            app:destination="@id/addContactFragment" />
    </fragment>

    <fragment
        android:id="@+id/addContactFragment"
        android:name="com.mohdhussain.hrcontacts.ui.add.AddContactFragment"
        android:label="Add HR Contact"
        tools:layout="@layout/fragment_add_contact" />

</navigation>
